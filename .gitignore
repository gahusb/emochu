# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
# 🔴 백업 사본까지 막는다. `.env*.local` 은 .local 로 끝나야 매칭돼서
#    .env.local.bak-203152 같은 파일이 추적 대상으로 남은 적이 있다(2026-08-31).
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# superpowers
.superpowers/

# loop 리포트 — 실행할 때마다 쌓인다(41일이면 100개 이상).
# 추적하면 매 실행마다 작업 트리가 더러워지는데 Loop 는 커밋 권한이 없어 정리도 못 한다.
# 리포트는 로컬 진단물이지 제출 증거가 아니다 — 호출 이력의 근거는 TourAPI 서버 쪽이다.
loops/*/outputs/*
!loops/*/outputs/.gitkeep

# temp files
patch-wizard.js

# 디자인 캔버스 시드 결과물 — 작업 파일(.dc.html·canvas.json)에서 언제든 재생성된다.
# 2MB 짜리 에디터 페이로드가 통째로 들어 있어 커밋하면 레포만 무거워진다.
design/*.html
# 🔴 다만 작업 파일(.dc.html)은 남긴다 — 이게 시안의 소스다.
#    `design/*.html` 만 두면 .dc.html 도 같이 삼켜서 다음 아트보드가 조용히 빠진다.
!design/*.dc.html

# 육안 확인용 임시 Playwright 스크린샷 도구 (세션 전용, 커밋 대상 아님)
.scratch-playwright/
