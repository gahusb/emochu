# ─── 이모추! 환경변수 ───

# TourAPI 4.0 (한국관광공사)
TOUR_API_KEY=

# 기상청 단기예보 API
WEATHER_API_KEY=

# Google Gemini AI
GEMINI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kakao SDK (카카오맵, 공유)
NEXT_PUBLIC_KAKAO_JS_KEY=

# ─── 운영 파라미터 (없으면 기본값) ───
# 상세: docs/2026-08-31-실서비스-과금-저장-공유-설계.md

# AI 호출 상한. GLOBAL 이 하루 최대 지출을 결정한다.
COURSE_DAILY_LIMIT_PER_CLIENT=20
COURSE_DAILY_LIMIT_GLOBAL=500
# 사용량 카운터의 IP 해시 솔트. 운영에선 지정 권장.
USAGE_HASH_SALT=
# 공유·저장을 누르지 않은 코스의 보관 기간(일)
COURSE_TTL_DAYS=30

# ─── 로그인 (기본 꺼짐) ───
# 🔴 Supabase 대시보드에서 OAuth 공급자 설정을 끝낸 뒤에만 true 로 둔다.
#    설정 전에 켜면 눌러도 에러만 나는 버튼이 생긴다.
NEXT_PUBLIC_AUTH_ENABLED=
# kakao(기본) | google
NEXT_PUBLIC_AUTH_PROVIDER=
